diff -ruN a/src/inc/quic_platform_mingw.h b/src/inc/quic_platform_mingw.h
--- a/src/inc/quic_platform_mingw.h	1969-12-31 19:00:00
+++ b/src/inc/quic_platform_mingw.h	2026-01-28 14:05:01
@@ -0,0 +1,509 @@
+/*++
+
+    Copyright (c) Microsoft Corporation.
+    Licensed under the MIT License.
+
+Abstract:
+
+    This file provides MinGW (GCC) compatibility and then includes the
+    Windows user mode platform header.
+
+Environment:
+
+    Windows user mode via MinGW-w64 cross-compiler
+
+--*/
+
+#pragma once
+
+#ifndef CX_PLATFORM_TYPE
+#error "Must be included from quic_platform.h"
+#endif
+
+//
+// SAL annotations must be stubbed out BEFORE including Windows headers
+//
+#include "quic_sal_stub.h"
+
+// MinGW doesn't have __noop - make it variadic to accept arguments
+#ifdef __noop
+#undef __noop
+#endif
+#define __noop(...) ((void)0)
+
+// __annotation is MSVC-specific - must produce an expression, not nothing
+#ifdef __annotation
+#undef __annotation
+#endif
+#define __annotation(...) ((void)0)
+
+// DECLSPEC_ALLOCATOR is MSVC-specific
+#ifndef DECLSPEC_ALLOCATOR
+#define DECLSPEC_ALLOCATOR
+#endif
+
+// E_NOT_VALID_STATE may not be defined in MinGW
+#ifndef E_NOT_VALID_STATE
+#define E_NOT_VALID_STATE ((HRESULT)0x8007139FL)
+#endif
+
+// MSVC interlocked intrinsics not in MinGW - use GCC builtins
+#ifndef InterlockedIncrementNoFence64
+#define InterlockedIncrementNoFence64(Addend) __sync_add_and_fetch((int64_t volatile*)(Addend), 1)
+#endif
+
+#ifndef InterlockedDecrementRelease64
+#define InterlockedDecrementRelease64(Addend) __sync_sub_and_fetch((int64_t volatile*)(Addend), 1)
+#endif
+
+#ifndef ReadNoFence64
+#define ReadNoFence64(Source) (*(volatile int64_t*)(Source))
+#endif
+
+#ifndef InterlockedCompareExchangeNoFence64
+#define InterlockedCompareExchangeNoFence64(Destination, Exchange, Comperand) \
+    __sync_val_compare_and_swap((int64_t volatile*)(Destination), (Comperand), (Exchange))
+#endif
+
+// 8-bit interlocked operations for MinGW
+#ifndef _InterlockedAnd8
+static __inline__ char _InterlockedAnd8(volatile char* Destination, char Value) {
+    return __sync_fetch_and_and(Destination, Value);
+}
+#endif
+
+#ifndef _InterlockedOr8
+static __inline__ char _InterlockedOr8(volatile char* Destination, char Value) {
+    return __sync_fetch_and_or(Destination, Value);
+}
+#endif
+
+// __kernel_entry is MSVC/NT specific
+#ifndef __kernel_entry
+#define __kernel_entry
+#endif
+
+#ifndef ReadPointerNoFence
+#define ReadPointerNoFence(Source) (*(void* volatile*)(Source))
+#endif
+
+// __analysis_assert is MSVC static analysis
+#ifndef __analysis_assert
+#define __analysis_assert(expr) ((void)0)
+#endif
+
+// FAST_FAIL codes
+#ifndef FAST_FAIL_INVALID_REFERENCE_COUNT
+#define FAST_FAIL_INVALID_REFERENCE_COUNT 0x18
+#endif
+
+// __fastfail is MSVC-specific, use abort() on MinGW
+#include <stdlib.h>
+#ifndef __fastfail
+#define __fastfail(code) abort()
+#endif
+
+// QUIC_INLINE for GCC
+#ifndef QUIC_INLINE
+#define QUIC_INLINE static __inline__ __attribute__((always_inline))
+#endif
+
+// _Static_assert for C11 compatibility with GCC
+#ifndef __cplusplus
+#ifndef static_assert
+#define static_assert _Static_assert
+#endif
+#endif
+
+// Define CXPLAT_STATIC_ASSERT before including winuser header
+#ifndef CXPLAT_STATIC_ASSERT
+#define CXPLAT_STATIC_ASSERT(X,Y) _Static_assert(X, Y)
+#endif
+
+//
+// Include Windows headers first to get their definitions
+// We'll override problematic ones after
+//
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN 1
+#endif
+
+// Fix MinGW winnt.h inconsistency:
+// winnt.h declares NtCurrentTeb() etc. as non-static prototypes, then defines
+// them as FORCEINLINE (static inline). This causes "static declaration follows
+// non-static declaration" errors. Redefine FORCEINLINE to remove 'static'.
+#ifdef FORCEINLINE
+#undef FORCEINLINE
+#endif
+#define FORCEINLINE __inline__ __attribute__((always_inline))
+
+#include <windows.h>
+
+// Restore FORCEINLINE to proper static inline for other uses
+#undef FORCEINLINE
+#define FORCEINLINE static __inline__ __attribute__((always_inline))
+#include <winsock2.h>
+#include <ws2tcpip.h>
+
+//
+// winternl.h types and functions needed by msquic but not in MinGW
+//
+
+// NTSTATUS is typedef'd in winnt.h but we need it for function declarations
+#ifndef NTSTATUS
+typedef LONG NTSTATUS;
+#endif
+
+// NT_SUCCESS macro from ntdef.h - checks if NTSTATUS is success
+#ifndef NT_SUCCESS
+#define NT_SUCCESS(Status) (((NTSTATUS)(Status)) >= 0)
+#endif
+
+// UNICODE_STRING structure from winternl.h
+#ifndef _UNICODE_STRING_DEFINED
+#define _UNICODE_STRING_DEFINED
+typedef struct _UNICODE_STRING {
+    USHORT Length;
+    USHORT MaximumLength;
+    PWSTR  Buffer;
+} UNICODE_STRING, *PUNICODE_STRING;
+#endif
+
+// THREADINFOCLASS enum from winternl.h (only the value we need)
+#ifndef THREADINFOCLASS
+typedef enum _THREADINFOCLASS {
+    ThreadBasicInformation = 0,
+    ThreadTimes = 1,
+    ThreadPriority = 2,
+    ThreadBasePriority = 3,
+    ThreadAffinityMask = 4,
+    ThreadImpersonationToken = 5,
+    ThreadDescriptorTableEntry = 6,
+    ThreadEnableAlignmentFaultFixup = 7,
+    ThreadEventPair_Reusable = 8,
+    ThreadQuerySetWin32StartAddress = 9,
+    ThreadZeroTlsCell = 10,
+    ThreadPerformanceCount = 11,
+    ThreadAmILastThread = 12,
+    ThreadIdealProcessor = 13,
+    ThreadPriorityBoost = 14,
+    ThreadSetTlsArrayAddress = 15,
+    ThreadIsIoPending = 16,
+    ThreadHideFromDebugger = 17
+} THREADINFOCLASS;
+#endif
+
+// RtlNtStatusToDosError is used to convert NT status codes
+#ifndef RtlNtStatusToDosError
+NTSYSAPI ULONG NTAPI RtlNtStatusToDosError(NTSTATUS Status);
+#endif
+
+//
+// IPv6 helper macros not available in MinGW
+// These are from the Windows SDK mstcpip.h
+//
+
+// IN6ADDR_SETV4MAPPED - Initialize an IPv6 address with an IPv4-mapped address
+#ifndef IN6ADDR_SETV4MAPPED
+#define IN6ADDR_SETV4MAPPED(Ipv6Address, Ipv4Address, ScopeId, Port) \
+    do { \
+        (Ipv6Address)->sin6_family = AF_INET6; \
+        (Ipv6Address)->sin6_port = (Port); \
+        (Ipv6Address)->sin6_flowinfo = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[0] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[1] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[2] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[3] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[4] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[5] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[6] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[7] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[8] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[9] = 0; \
+        (Ipv6Address)->sin6_addr.s6_addr[10] = 0xff; \
+        (Ipv6Address)->sin6_addr.s6_addr[11] = 0xff; \
+        *((ULONG*)&(Ipv6Address)->sin6_addr.s6_addr[12]) = *((ULONG*)(Ipv4Address)); \
+        (Ipv6Address)->sin6_scope_id = (ScopeId).Value; \
+    } while (0)
+#endif
